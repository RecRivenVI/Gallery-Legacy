{
  "name": "gallery",
  "version": "10.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Filesystem-authoritative Gallery for nine fixed platforms and read-only file browsing",
  "main": "src/desktop/main.js",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "start": "node bin/gallery.cjs serve",
    "manager": "node tools/desktop/run.cjs",
    "scan": "node bin/gallery.cjs scan",
    "validate": "node bin/gallery.cjs validate",
    "publish": "node bin/gallery.cjs publish",
    "rollback": "node bin/gallery.cjs rollback",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.js\"",
    "test:go": "node tools/go/run.cjs test -count=1 -timeout=18m ./internal/...",
    "vet:go": "node tools/go/run.cjs vet ./internal/... ./cmd/...",
    "test:race": "node tools/go/run.cjs test -race -count=1 ./cmd/... ./internal/...",
    "test:protocol": "node tools/validation/protocol-diff.cjs",
    "test:reader": "node tools/validation/reader-diff.cjs",
    "test:schema": "node tools/validation/schema-diff.cjs",
    "test:recovery": "node tools/validation/recovery-diff.cjs",
    "test:config": "node tools/validation/config-diff.mjs",
    "test:dataset": "node tools/validation/dataset-diff.mjs",
    "test:http": "node tools/validation/http-diff.mjs",
    "test:http-browser": "node tools/validation/http-browser.mjs",
    "check": "node --check bin/gallery.cjs",
    "check:electron": "node --check src/desktop/main.js && node --check src/desktop/preload.js",
    "prepare:test": "node tools/validation/prepare.cjs",
    "test:integration": "node --test --test-concurrency=1 tools/validation/host-test.cjs tools/validation/incremental-test.cjs tools/validation/native-test.cjs tools/validation/test.cjs tools/validation/dispatch-test.cjs",
    "build": "node tools/build/run.cjs",
    "package:windows": "node tools/package/run.cjs",
    "retain": "node bin/gallery.cjs retain",
    "format": "prettier --write src public bin tools test package.json package-lock.json && node tools/go/run.cjs fmt ./internal/... ./cmd/..."
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "canvaskit-wasm": "0.42.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "playwright": "1.61.1",
    "prettier": "3.6.2"
  }
}
