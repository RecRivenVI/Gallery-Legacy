{
  "name": "gallery-development",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "start": "pwsh -NoProfile -File tools/desktop/run.ps1",
    "build": "pwsh -NoProfile -File tools/build/run.ps1",
    "test:go": "node tools/go/run.mjs test -count=1 -timeout=18m ./...",
    "vet:go": "node tools/go/run.mjs vet ./...",
    "test:race": "node tools/go/run.mjs test -race -count=1 -timeout=18m ./internal/...",
    "test:browser": "node tools/validation/browser.mjs",
    "test:native": "node tools/validation/native.mjs",
    "test:interactions": "node tools/validation/interactions.mjs",
    "format": "prettier --write tools ui/src/wasmJsMain/resources/bootstrap.js ui/src/wasmJsMain/resources/bootstrap.css ui/src/wasmJsMain/resources/index.html package.json package-lock.json && node tools/go/run.mjs fmt ./..."
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "prettier": "3.6.2"
  }
}
