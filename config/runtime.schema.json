{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gallery local instance configuration",
  "type": "object",
  "required": ["instanceRoot", "sources"],
  "additionalProperties": false,
  "properties": {
    "liveUpdates": { "type": "boolean", "default": false },
    "deployment": { "enum": ["development", "staging", "production"] },
    "instanceRoot": { "type": "string", "minLength": 3 },
    "mode": { "enum": ["local", "lan", "public"], "default": "local" },
    "host": { "type": "string", "default": "127.0.0.1" },
    "listenAddress": { "type": "string" },
    "allowedHosts": { "type": "array", "items": { "type": "string" } },
    "allowedOrigins": { "type": "array", "items": { "type": "string" } },
    "publicUrl": { "type": "string" },
    "fileBrowserRoots": { "type": "array", "items": { "type": "object", "required": ["id", "path"], "properties": { "id": {"type":"string"}, "name": {"type":"string"}, "path": {"type":"string"} }, "additionalProperties": false } },
    "shortLinks": { "type": "object", "additionalProperties": { "type": "string" } },
    "retention": { "type": "object", "properties": { "enabled": { "type":"boolean" }, "staleAfterMs": {"type":"integer","minimum":3600000} }, "additionalProperties":false },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 18104
    },
    "sources": {
      "type": "object",
      "required": [
        "pixiv",
        "pixivFANBOX",
        "Gank",
        "Fantia",
        "Patreon",
        "Pawchive",
        "X",
        "微博",
        "Venera"
      ],
      "minProperties": 9,
      "maxProperties": 9,
      "propertyNames": {
        "enum": [
          "pixiv",
          "pixivFANBOX",
          "Gank",
          "Fantia",
          "Patreon",
          "Pawchive",
          "X",
          "微博",
          "Venera"
        ]
      },
      "additionalProperties": { "type": "string", "minLength": 3 }
    },
    "generationsRoot": { "type": "string" },
    "cacheRoot": { "type": "string" },
    "logsRoot": { "type": "string" },
    "tempRoot": { "type": "string" },
    "stateRoot": { "type": "string" },
    "reportsRoot": { "type": "string" },
    "desktopDataRoot": { "type": "string" }
  },
  "$comment": "Native absolute paths, physical aliases, overlap and source/generation safety are checked by internal/instance/config.js; null example values intentionally do not validate until configured."
}
